{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@atlas/renderer",
    "types": ["bun"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "data/**/*",
    "elements/**/*",
    "lib/**/*",
    "fonts.ts",
    "atlas.config.ts",
    "scripts/**/*"
  ]
}
