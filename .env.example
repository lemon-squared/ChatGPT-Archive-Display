# Copy to `.env` and fill in values:
#   cp .env.example .env
#
# Bun loads `.env` automatically for scripts like `ensure-atlas` / `dev` / `build`.

# Fine-grained GitHub PAT with Contents: Read on lemon-squared/Atlas.
# Required until @atlas/* packages are published to npm (clones vendor/Atlas).
ATLAS_GITHUB_TOKEN=

# Access logs (@atlas/runtime). Pretty on stdout unless production.
# ATLAS_LOG=0              # disable request logs
# ATLAS_LOG_PRETTY=0       # JSON (log drain)
# ATLAS_LOG_PRETTY=1       # force pretty
